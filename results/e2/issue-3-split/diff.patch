--- a/tinydb/operations.py
+++ b/tinydb/operations.py
@@ -73,3 +73,19 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
         doc[field] -= 1
 
     return transform
+
+
+def append(field: str, value: Any) -> Callable[[MutableMapping], None]:
+    """
+    Append a value to an existing list field in the document.
+
+    If the field is absent, it is created as a one-element list. Appends
+    the value as a single element, preserving preceding elements.
+    """
+    def transform(doc: MutableMapping):
+        if field in doc:
+            doc[field].append(value)
+        else:
+            doc[field] = [value]
+
+    return transform
