+    def __contains__(self, item: Any) -> bool:
+        """
+        Check if the table contains a document with the given document ID or
+        matching a query.
+
+        :param item: Document ID (int) or query (callable).
+        :returns: True if found, False otherwise.
+        """
+        if isinstance(item, int) and not isinstance(item, bool):
+            return self.contains(doc_id=item)
+        elif callable(item):
+            return self.contains(cond=item)
+        else:
+            raise TypeError(
+                f'Invalid operand for membership test: expected int (doc_id) '
+                f'or callable (query), got {type(item).__name__}'
+            )
